{
  "name": "tizen3-sofa-browser",
  "version": "0.6.0",
  "description": "A remote-friendly TizenBrew browser for Tizen 3 with best-effort ad blocking and direct-stream playback.",
  "license": "MIT",
  "packageType": "mods",
  "appName": "Sofa Browser \u00b7 Tizen 3",
  "websiteURL": "http://127.0.0.1:8081/#sofa-home",
  "main": "browser.js",
  "evaluateScriptOnDocumentStart": false,
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue"
  ],
  "keywords": [
    "tizenbrew",
    "tizen3",
    "samsung-tv",
    "browser",
    "remote"
  ]
}
